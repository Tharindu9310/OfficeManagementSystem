@*
    Shell of the "Edit stores and translations" modal (Bootstrap 4, same page, no navigation).
    The body is loaded into #expensecategory-stores-translations-body by Content/expensecategory-grid.js
    from ExpenseCategoryController.EditStoresAndTranslations and posted to SaveStoresAndTranslations.
    Bootstrap supplies the focus trap, Escape to close and the backdrop; the script returns focus to the
    opening button.
*@
<div class="modal fade" id="expensecategory-stores-translations-modal" tabindex="-1" role="dialog" aria-modal="true"
     aria-labelledby="expensecategory-stores-translations-title"
     data-load-url="@Url.Action("EditStoresAndTranslations", "ExpenseCategory")"
     data-save-url="@Url.Action("SaveStoresAndTranslations", "ExpenseCategory")"
     data-saved-text="@T("Admin.Expenses.ExpenseCategory.StoresAndTranslations.Saved")">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="expensecategory-stores-translations-title">@T("Admin.Expenses.ExpenseCategory.StoresAndTranslations.Title")</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="@T("Admin.Expenses.ExpenseCategory.Accessibility.CloseDialog")">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div id="expensecategory-stores-translations-body"></div>
        </div>
    </div>
</div>
